+bool FUltimateMCPServer::IsAuthorized(const FHttpServerRequest& Request) const
+{
+	for (const TPair<FString, FString>& Header : Request.Headers)
+	{
+		if (Header.Key.Equals(TEXT("X-UE5-Codex-Token"), ESearchCase::IgnoreCase))
+		{
+			const FString& Presented = Header.Value;
+			return Presented.Len() == CapabilityToken.Len()
+				&& FMemory::Memcmp(*Presented, *CapabilityToken, Presented.Len() * sizeof(TCHAR)) == 0;
+		}
+	}
+	return false;
+}
+
+bool FUltimateMCPServer::RejectUnauthorized(const FHttpServerRequest& Request, const FHttpResultCallback& OnComplete) const
+{
+	if (IsAuthorized(Request)) return false;
+	TSharedPtr<FJsonObject> Error = MakeShared<FJsonObject>();
+	Error->SetBoolField(TEXT("success"), false);
+	Error->SetStringField(TEXT("error"), TEXT("capability token missing or invalid"));
+	SendJsonResponse(OnComplete, 401, Error);
+	return true;
+}
