{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "id", "operation_id", "action", "capability_id", "effect", "status", "subject_refs", "target_path", "expected_readback"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^dcc_operation_[a-z0-9_]+$"},
    "operation_id": {"type": "string", "pattern": "^operation_[a-z0-9_]+$"},
    "action": {"enum": ["create_mesh", "create_sculpt", "import_new_asset", "edit_existing_mesh", "delete_asset"]},
    "capability_id": {"type": "string"},
    "effect": {"enum": ["CREATE", "MODIFY", "DELETE"]},
    "status": {"enum": ["DRAFT", "BLOCKED", "READY"]},
    "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "target_path": {"type": "string", "minLength": 1},
    "expected_readback": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "approval_record": {"type": ["string", "null"], "pattern": "^approval_[a-z0-9_]+$"}
  },
  "additionalProperties": false
}
