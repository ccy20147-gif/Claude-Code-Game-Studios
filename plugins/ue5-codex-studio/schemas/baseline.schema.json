{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "gdd", "acceptance", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^baseline_[a-z0-9_]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "CANDIDATE", "ACCEPTED", "SUPERSEDED"]},
    "gdd": {"type": "object"},
    "acceptance": {"type": "object"},
    "requirements": {"type": "array", "items": {"type": "string", "pattern": "^req_[a-z0-9_]+$"}},
    "waivers": {"type": "array"}
  },
  "additionalProperties": true
}
