{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "platform", "configuration", "project", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "platform": {"const": "Win64"},
    "configuration": {"const": "Shipping"},
    "project": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "size", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
